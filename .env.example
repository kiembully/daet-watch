# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas. The app boots WITHOUT this and serves the offline/empty shell,
# but every write is refused with 503 db_unavailable.
MONGODB_URI="mongodb+srv://<user>:<password>@all-templated-projects.dux29bf.mongodb.net/daet-watch?retryWrites=true&w=majority"
MONGODB_DB=daet-watch

# ─── Auth (Auth.js v5) ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Absolute origin, no trailing slash. Used for OG/canonical URLs and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Facebook OAuth — https://developers.facebook.com/apps
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Demo sign-in (phone number, no OTP verification). Lets every flow be exercised
# before the OAuth apps exist. MUST be empty in production once real login works.
ENABLE_DEMO_LOGIN=1

# ─── Images (Cloudinary, signed direct upload) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=daet-watch

# ─── Moderation bootstrap ────────────────────────────────────────────────────
# Comma-separated emails that are promoted to moderator on seed/sign-in.
MODERATOR_EMAILS=
# The seeded moderator account, reachable through the demo phone login.
SEED_MODERATOR_EMAIL=moderator@daet.watch
SEED_MODERATOR_PHONE=09000000000

# ─── Rate limits (per resident, per rolling day) ─────────────────────────────
RATE_LIMIT_REPORTS_PER_DAY=5
RATE_LIMIT_CONFIRMS_PER_DAY=20
RATE_LIMIT_FLAGS_PER_DAY=10

# ─── Business rules (defaults match the spec) ────────────────────────────────
NEXT_PUBLIC_FIX_THRESHOLD=3
NEXT_PUBLIC_REOPEN_WINDOW_DAYS=60

# ─── Maps ────────────────────────────────────────────────────────────────────
# OSM public tiles are fine at Daet's volume. Override if you move to a paid host.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# ─── Push (feature-flagged, off until VAPID keys exist) ──────────────────────
# npx web-push generate-vapid-keys
NEXT_PUBLIC_PUSH_ENABLED=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.org
